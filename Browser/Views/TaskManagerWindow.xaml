<Window x:Class="Browser.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser-Task-Manager"
        Height="420" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Background="{StaticResource BgSurfaceBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14"
                       Background="Transparent"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Click="BtnClose_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Width="28" Height="28">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                </Button>
                <TextBlock Text="Browser-Task-Manager"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Tabs and processes list -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <DataGrid x:Name="TasksDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="Transparent"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          RowBackground="Transparent"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Padding" Value="4" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tab-Titel" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="150" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer Actions -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <Button DockPanel.Dock="Left"
                        Content="Aktualisieren"
                        Click="BtnRefresh_Click"
                        Padding="12,6"
                        Cursor="Hand"
                        Background="{StaticResource BgHoverBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Prozess / Tab beenden"
                            Click="BtnEndTab_Click"
                            Padding="12,6"
                            Cursor="Hand"
                            Background="{StaticResource StatusErrorBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
