<Window x:Class="Browser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Icon="Assets/nexa_icon.png"
        Height="650" Width="880"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon"
                                           Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Card Border Style -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Kbd Key Style -->
        <Style x:Key="KbdKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Main Container with Shadow & Rounded Corners -->
    <Border BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Background="{StaticResource BgSurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.5" ShadowDepth="6" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="46" />
                <!-- Body (Sidebar + Content) -->
                <RowDefinition Height="*" />
                <!-- Footer (Save / Close) -->
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- ═══ Titlebar ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgDeepestBrush}"
                    CornerRadius="11,11,0,0"
                    Padding="16,0,10,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Click="BtnClose_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Width="30" Height="30"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                               Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                        <TextBlock Text="Browser-Einstellungen"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Body: Sidebar + Panels ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar (Categories) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgDeepBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="4,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <RadioButton Content="Darstellung" Tag="&#xE790;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Click="Nav_Click" />
                            <RadioButton Content="Suche" Tag="&#xE721;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Tabs" Tag="&#xE737;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Startseite &amp; NewTab" Tag="&#xE80F;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Datenschutz" Tag="&#xE72E;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Downloads" Tag="&#xE896;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Berechtigungen" Tag="&#xE8D7;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Tastenkürzel" Tag="&#xE765;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="10,6" />
                            <RadioButton Content="Über den Browser" Tag="&#xE946;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Content Area (Switchable Panels) -->
                <ScrollViewer Grid.Column="1"
                              x:Name="ContentScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18">
                    <Grid>
                        <!-- ════ PANEL 1: Darstellung ════ -->
                        <StackPanel x:Name="PanelDarstellung" Visibility="Visible">
                            <TextBlock Text="Darstellung" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Passe das visuelle Erscheinungsbild und die Animationen an." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="380">
                                        <TextBlock Text="Standard-Zoomfaktor" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Legt die standardmäßige Vergrößerung beim Öffnen neuer Webseiten fest." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="ComboDefaultZoom"
                                              Width="110"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="50%" Tag="0.5" />
                                        <ComboBoxItem Content="75%" Tag="0.75" />
                                        <ComboBoxItem Content="90%" Tag="0.9" />
                                        <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                                        <ComboBoxItem Content="110%" Tag="1.1" />
                                        <ComboBoxItem Content="125%" Tag="1.25" />
                                        <ComboBoxItem Content="150%" Tag="1.5" />
                                        <ComboBoxItem Content="175%" Tag="1.75" />
                                        <ComboBoxItem Content="200%" Tag="2.0" />
                                    </ComboBox>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Animationen &amp; Übergänge" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Aktiviert sanfte Hover-, Einblend- und Lade-Effekte in der Benutzeroberfläche." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableAnimations"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Akzentfarbe &amp; Personalisierung" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Wähle deine Lieblings-Akzentfarbe für Buttons, Tabs, Badges und Markierungen (wird sofort live angewendet)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,12" />
                                    <WrapPanel x:Name="ThemeSwatchesPanel" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Farbschema" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Modernes Windows 11 Dark Mode Design mit Fluent-Akzenten." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Background="{StaticResource AccentDimBrush}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Dark Mode" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 2: Suche ════ -->
                        <StackPanel x:Name="PanelSuche" Visibility="Collapsed">
                            <TextBlock Text="Suche" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Wähle deine bevorzugte Suchmaschine und Einstellungen für die Omnibox." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Standardsuchmaschine" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Diese Suchmaschine wird ausgeführt, wenn Text in die Adressleiste eingegeben wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" />
                                    <ComboBox x:Name="ComboSearchEngine"
                                              Padding="8,6"
                                              Margin="0,4,0,0">
                                        <ComboBoxItem Content="Google (https://www.google.com/search?q=)" IsSelected="True" />
                                        <ComboBoxItem Content="DuckDuckGo (https://duckduckgo.com/?q=)" />
                                        <ComboBoxItem Content="Bing (https://www.bing.com/search?q=)" />
                                        <ComboBoxItem Content="Ecosia (https://www.ecosia.org/search?q=)" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Suchvorschläge in der Adressleiste" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Zeigt passende Vorschläge aus Lesezeichen und bisherigem Verlauf während der Eingabe." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSearchSuggestions"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 3: Tabs ════ -->
                        <StackPanel x:Name="PanelTabs" Visibility="Collapsed">
                            <TextBlock Text="Tabs &amp; Organisation" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Steuere das Verhalten beim Öffnen, Gruppieren und Schließen von Tabs." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Neue Tabs neben aktuellem Tab öffnen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Öffnet neu erstellte Tabs direkt rechts neben dem aktuell aktiven Tab statt ganz am Ende." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkOpenBesideActive"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Farbige Tab-Gruppen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Ermöglicht das Zuweisen von Tabs zu farblichen Gruppen (Arbeit, Recherche, Privat, Medien) per Rechtsklick." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableTabGroups"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Tab-Schlafmodus Card -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                            <TextBlock Text="💤 Tab-Schlafmodus (RAM &amp; CPU-Schoner)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Versetzt inaktive Tabs automatisch in den Ruhezustand, um Arbeitsspeicher und Systemressourcen freizugeben. Tabs wachen beim Anklicken sofort auf." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkEnableSleepingTabs"
                                                  IsChecked="True"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inaktive Tabs in Ruhezustand versetzen nach:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="ComboSleepingTimeout" Grid.Column="1" Width="140" Padding="8,4">
                                                <ComboBoxItem Content="5 Minuten" Tag="5" />
                                                <ComboBoxItem Content="15 Minuten" Tag="15" IsSelected="True" />
                                                <ComboBoxItem Content="30 Minuten" Tag="30" />
                                                <ComboBoxItem Content="1 Stunde" Tag="60" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="Angeheftete Tabs niemals schlafen legen" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ChkNeverSleepPinned" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="380">
                                        <TextBlock Text="Zuletzt geschlossene Tabs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Kürzlich geschlossene Tabs können jederzeit per Tastaturkürzel wiederhergestellt werden." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Strg + Umschalt + T" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 4: Startseite & NewTab ════ -->
                        <StackPanel x:Name="PanelStart" Visibility="Collapsed">
                            <TextBlock Text="Start &amp; Neue Tabs" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Bestimme, was beim Öffnen des Browsers oder eines neuen Tabs angezeigt wird." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Beim Starten des Browsers" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                    <RadioButton x:Name="RadioStartNewTab" Content="Startseite öffnen" GroupName="StartMode" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <RadioButton x:Name="RadioStartRestore" Content="Vorherige Sitzung mit allen Tabs wiederherstellen" GroupName="StartMode" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Startseite" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Wähle deine bevorzugte Startseite, die beim Öffnen des Browsers oder beim Klick auf den Home-Button (Alt+Pos1) geladen wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,10" />

                                    <RadioButton x:Name="RadioHomeNexa"
                                                 Content="Nexa Startseite (about:start – mit Uhrzeit und Suche)"
                                                 GroupName="HomePageSelection"
                                                 Checked="RadioHome_Checked"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Margin="0,0,0,8" />

                                    <RadioButton x:Name="RadioHomeGoogle"
                                                 Content="Google (https://www.google.com)"
                                                 GroupName="HomePageSelection"
                                                 Checked="RadioHome_Checked"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Margin="0,0,0,8" />

                                    <RadioButton x:Name="RadioHomeCustom"
                                                 Content="Benutzerdefiniert (Eigene Webadresse)"
                                                 GroupName="HomePageSelection"
                                                 Checked="RadioHome_Checked"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Margin="0,0,0,8" />

                                    <!-- Custom URL Input (visible when custom selected) -->
                                    <StackPanel x:Name="PanelCustomHomeUrl" Margin="22,4,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Eigene Webadresse eingeben:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtHomePage"
                                                 Padding="10,7"
                                                 Background="{StaticResource BgSurfaceBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 CaretBrush="{StaticResource AccentLightBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 5: Datenschutz ════ -->
                        <StackPanel x:Name="PanelDatenschutz" Visibility="Collapsed">
                            <TextBlock Text="Datenschutz &amp; Sicherheit" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Verwalte Cookies, temporäre Dateien, Verlauf und automatische Datenbereinigung." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Browserdaten jetzt bereinigen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Lösche selektiv gespeicherte Daten von deinem Computer." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,12" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="Cookies löschen" Click="BtnClearCookies_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                        <Button Content="Cache leeren" Click="BtnClearCache_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                        <Button Content="Gesamten Verlauf leeren" Click="BtnClearHistory_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource StatusWarningBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Integrierter Werbe- &amp; Tracker-Schutz (Privacy Shield)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Blockiert aggressive Werbebanner, Analytik- und Telemetrie-Skripte automatisch für schnellere Ladezeiten und höheren Datenschutz." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableAdBlocker"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Browserdaten beim Beenden löschen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Löscht Cache, Cookies und Verlauf automatisch bei jedem Schließen des Browserfensters." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkClearDataOnExit"
                                              IsChecked="False"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="InPrivate-Modus (Inkognito)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Für maximale Privatsphäre kannst du ein InPrivate-Fenster (Strg+Umschalt+N) öffnen. In diesem Modus werden Verläufe, Cookies und Webdaten in einem isolierten Speicher abgelegt, der beim Schließen rückstandsfrei gelöscht wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 6: Downloads ════ -->
                        <StackPanel x:Name="PanelDownloads" Visibility="Collapsed">
                            <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Konfiguriere den Speicherort und das Verhalten für heruntergeladene Dateien." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Download-Speicherort" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="In diesen Ordner werden heruntergeladene Dateien standardmäßig gespeichert." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Durchsuchen..."
                                                Click="BtnBrowseDownloadFolder_Click"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                Background="{StaticResource BgHoverBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand" />
                                        <TextBox x:Name="TxtDownloadFolder"
                                                 Padding="10,7"
                                                 Background="{StaticResource BgSurfaceBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 CaretBrush="{StaticResource AccentLightBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Vor jedem Download nach Speicherort fragen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Zeigt vor jedem Download einen Dateidialog zur Auswahl des Zielordners und Dateinamens an." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAskDownloadLocation"
                                              IsChecked="False"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 7: Website-Berechtigungen ════ -->
                        <StackPanel x:Name="PanelBerechtigungen" Visibility="Collapsed">
                            <TextBlock Text="Website-Berechtigungen" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Verwalte den Zugriff von Websites auf Kamera, Mikrofon, Standort und Pop-ups." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Standardberechtigungen für neue Websites" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                    <!-- Camera -->
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Kamera" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboPermCamera" Width="130" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                            <ComboBoxItem Content="Erlauben" />
                                            <ComboBoxItem Content="Blockieren" />
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Microphone -->
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="Mikrofon" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboPermMicrophone" Width="130" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                            <ComboBoxItem Content="Erlauben" />
                                            <ComboBoxItem Content="Blockieren" />
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Geolocation -->
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="Standort" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboPermGeolocation" Width="130" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                            <ComboBoxItem Content="Erlauben" />
                                            <ComboBoxItem Content="Blockieren" />
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Notifications -->
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="Benachrichtigungen" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboPermNotifications" Width="130" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                            <ComboBoxItem Content="Erlauben" />
                                            <ComboBoxItem Content="Blockieren" />
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Pop-ups -->
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="Pop-up-Fenster" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboPermPopups" Width="130" HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Erlauben" IsSelected="True" />
                                            <ComboBoxItem Content="Blockieren" />
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Gespeicherte Website-Berechtigungen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="Alle zurücksetzen" Click="BtnResetAllPermissions_Click" Padding="10,4" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource StatusErrorBrush}" BorderThickness="0" Cursor="Hand" />
                                    </DockPanel>
                                    <ListBox x:Name="ListSavedPermissions"
                                             MaxHeight="150"
                                             Background="{StaticResource BgSurfaceBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             BorderThickness="1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 8: Tastenkürzel ════ -->
                        <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                            <TextBlock Text="Tastenkürzel (Shortcuts)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Schnelle Navigation und Bedienung über Tastenkombinationen." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <!-- Tabs & Navigation -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tabs &amp; Fenster" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                    <Grid Margin="0,3"><TextBlock Text="Neuer Tab" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + T" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Tab schließen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + W" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Geschlossenen Tab wiederherstellen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + T" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Nächster / Vorheriger Tab" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Tab / Strg + Umschalt + Tab" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Tab duplizieren" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + D" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Tab nach links / rechts verschieben" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + Bild↑ / Bild↓" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Tab stummschalten / laut schalten" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + M" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Neues Fenster / InPrivate-Fenster" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + N / Strg + Umschalt + N" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                </StackPanel>
                            </Border>

                            <!-- Omnibox & Actions -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Webseite &amp; Aktionen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                    <Grid Margin="0,3"><TextBlock Text="Adressleiste fokussieren" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + L" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Schnellsuche (Quick Search)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + K" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Neu laden / Stop" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="F5 / Strg + R" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Zurück / Vor / Startseite" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Alt + Links / Alt + Rechts / Alt + Pos1" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Lesezeichen hinzufügen / entfernen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + D" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Verlauf anzeigen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + H" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Auf Seite suchen (Find)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + F" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Drucken / Seite speichern" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + P / Strg + S" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Zoom anpassen (Vergrößern / Verkleinern / 100%)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + [+] / [-] / [0]" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Vollbildmodus ein/aus" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="F11" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Browser-Task-Manager" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Umschalt + Esc" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ════ PANEL 9: Über den Browser ════ -->
                        <StackPanel x:Name="PanelUeber" Visibility="Collapsed">
                            <TextBlock Text="Über den Browser" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Systeminformationen, Versionen und Update-Prüfung." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border Width="48" Height="48" Background="{StaticResource AccentDimBrush}" CornerRadius="12" DockPanel.Dock="Left" Margin="0,0,14,0">
                                            <Image Source="pack://application:,,,/Assets/nexa_icon.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAboutBrowserName" Text="Nexa Browser" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Moderner, leichtgewichtiger Windows 11 Browser" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,10" />

                                    <Grid Margin="0,4"><TextBlock Text="Browser-Version" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtAppVersion" Text="v1.0.0 (Release)" HorizontalAlignment="Right" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                                    <Grid Margin="0,4"><TextBlock Text="WebView2 Runtime" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtWebViewVersion" Text="Wird ermittelt..." HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                                    <Grid Margin="0,4"><TextBlock Text="Framework" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtDotNetVersion" Text=".NET 10.0 (Windows x64)" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Aktualisierungen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtUpdateStatus" Text="Der Browser ist auf dem neuesten Stand." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Content="Updates prüfen"
                                            Click="BtnCheckUpdates_Click"
                                            Padding="14,6"
                                            Background="{StaticResource BgHoverBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="Entwicklertools (F12)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Ermöglicht das Öffnen der Chromium-Entwicklertools zum Untersuchen von Webseiten." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableDevTools"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ═══ Footer ═══ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgDeepestBrush}"
                    CornerRadius="0,0,11,11"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Abbrechen"
                                Click="BtnClose_Click"
                                Padding="14,6"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,8,0" />
                        <Button Content="Speichern"
                                Click="BtnSave_Click"
                                Padding="16,6"
                                Background="{StaticResource AccentPrimaryBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
