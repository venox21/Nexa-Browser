<UserControl x:Class="Browser.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Resources>
        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon"
                                           Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Card Border Style -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Kbd Key Style -->
        <Style x:Key="KbdKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Settings Action Button Style -->
        <Style x:Key="SettingsActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Primary Button Style -->
        <Style x:Key="SettingsPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionBtnStyle}">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Vault Icon Button Style -->
        <Style x:Key="VaultIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Body (Sidebar + Content) -->
            <RowDefinition Height="*" />
            <!-- Footer (Save Status + Save Button) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Body: Sidebar + Panels ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Categories) -->
                <ColumnDefinition Width="240" />
                <!-- Right Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgDeepestBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0"
                            Padding="18,20,18,16"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentDimBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                                       Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Einstellungen"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Nexa Konfiguration"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="6,12">
                        <StackPanel>
                            <RadioButton Content="Darstellung" Tag="&#xE790;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Click="Nav_Click" />
                            <RadioButton Content="Suche" Tag="&#xE721;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Tabs &amp; Leistung" Tag="&#xE737;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Startseite &amp; NewTab" Tag="&#xE80F;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Datenschutz" Tag="&#xE72E;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Downloads" Tag="&#xE896;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Berechtigungen" Tag="&#xE8D7;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton Content="Tastenkürzel" Tag="&#xE765;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton x:Name="NavPasswoerter" Content="Passwörter &amp; Autofill" Tag="&#xE8AC;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <RadioButton x:Name="NavSync" Content="Konto &amp; Sync" Tag="&#xE77B;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="12,8" />
                            <RadioButton Content="Über Nexa" Tag="&#xE946;" GroupName="SettingsNav" Style="{StaticResource SidebarNavButtonStyle}" Click="Nav_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Content Area (Switchable Panels) -->
            <ScrollViewer Grid.Column="1"
                          x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Padding="36,28">
                <Grid MaxWidth="860" HorizontalAlignment="Center" Width="Auto">
                    <!-- ════ PANEL 1: Darstellung ════ -->
                    <StackPanel x:Name="PanelDarstellung" Visibility="Visible">
                        <TextBlock Text="Darstellung" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Passe das visuelle Erscheinungsbild, Farben und Animationen an." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Standard-Zoomfaktor" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Legt die standardmäßige Vergrößerung beim Öffnen neuer Webseiten fest." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ComboDefaultZoom"
                                          Width="110"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="50%" Tag="0.5" />
                                    <ComboBoxItem Content="75%" Tag="0.75" />
                                    <ComboBoxItem Content="90%" Tag="0.9" />
                                    <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                                    <ComboBoxItem Content="110%" Tag="1.1" />
                                    <ComboBoxItem Content="125%" Tag="1.25" />
                                    <ComboBoxItem Content="150%" Tag="1.5" />
                                    <ComboBoxItem Content="175%" Tag="1.75" />
                                    <ComboBoxItem Content="200%" Tag="2.0" />
                                </ComboBox>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Animationen &amp; Übergänge" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Aktiviert sanfte Hover-, Einblend- und Lade-Effekte in der Benutzeroberfläche." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkEnableAnimations"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Akzentfarbe &amp; Theme-Personalisierung" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Wähle deine Lieblings-Akzentfarbe für Buttons, Tabs, Badges und Markierungen (wird sofort live angewendet)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,12" />
                                <WrapPanel x:Name="ThemeSwatchesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Farbschema" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Obsidian Midnight Dark Mode Design mit tiefen Kontrasten." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Background="{StaticResource AccentDimBrush}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Obsidian Dark" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 2: Suche ════ -->
                    <StackPanel x:Name="PanelSuche" Visibility="Collapsed">
                        <TextBlock Text="Suche" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Wähle deine bevorzugte Suchmaschine und Einstellungen für die Omnibox." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Standardsuchmaschine" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Diese Suchmaschine wird ausgeführt, wenn Text in die Adressleiste eingegeben wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" />
                                <ComboBox x:Name="ComboSearchEngine"
                                          Padding="8,6"
                                          Margin="0,4,0,0">
                                    <ComboBoxItem Content="Google (https://www.google.com/search?q=)" IsSelected="True" />
                                    <ComboBoxItem Content="DuckDuckGo (https://duckduckgo.com/?q=)" />
                                    <ComboBoxItem Content="Bing (https://www.bing.com/search?q=)" />
                                    <ComboBoxItem Content="Ecosia (https://www.ecosia.org/search?q=)" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Suchvorschläge in der Adressleiste" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Zeigt passende Vorschläge aus Lesezeichen und bisherigem Verlauf während der Eingabe." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkSearchSuggestions"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 3: Tabs & Leistung ════ -->
                    <StackPanel x:Name="PanelTabs" Visibility="Collapsed">
                        <TextBlock Text="Tabs &amp; Leistung" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Steuere das Verhalten beim Öffnen, Gruppieren, Schlafenlegen und Schließen von Tabs." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Neue Tabs neben aktuellem Tab öffnen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Öffnet neu erstellte Tabs direkt rechts neben dem aktuell aktiven Tab statt ganz am Ende." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkOpenBesideActive"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Farbige Tab-Gruppen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ermöglicht das Zuweisen von Tabs zu farblichen Gruppen (Arbeit, Recherche, Privat, Medien) per Rechtsklick." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkEnableTabGroups"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Tab-Schlafmodus Card -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                        <TextBlock Text="💤 Tab-Schlafmodus (RAM &amp; CPU-Schoner)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Versetzt inaktive Tabs automatisch in den Ruhezustand, um Arbeitsspeicher und Systemressourcen freizugeben. Tabs wachen beim Anklicken sofort auf." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableSleepingTabs"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </DockPanel>

                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="0,10,0,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Inaktive Tabs in Ruhezustand versetzen nach:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ComboSleepingTimeout" Grid.Column="1" Width="140" Padding="8,4">
                                            <ComboBoxItem Content="5 Minuten" Tag="5" />
                                            <ComboBoxItem Content="15 Minuten" Tag="15" IsSelected="True" />
                                            <ComboBoxItem Content="30 Minuten" Tag="30" />
                                            <ComboBoxItem Content="1 Stunde" Tag="60" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Angeheftete Tabs niemals schlafen legen" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkNeverSleepPinned" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="380">
                                    <TextBlock Text="Zuletzt geschlossene Tabs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Kürzlich geschlossene Tabs können jederzeit per Tastaturkürzel wiederhergestellt werden." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Strg + Umschalt + T" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 4: Startseite & NewTab ════ -->
                    <StackPanel x:Name="PanelStart" Visibility="Collapsed">
                        <TextBlock Text="Start &amp; Neue Tabs" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Bestimme, was beim Öffnen des Browsers oder eines neuen Tabs angezeigt wird." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Beim Starten des Browsers" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <RadioButton x:Name="RadioStartNewTab" Content="Startseite öffnen" GroupName="StartMode" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <RadioButton x:Name="RadioStartRestore" Content="Vorherige Sitzung mit allen Tabs wiederherstellen" GroupName="StartMode" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Startseite" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Wähle deine bevorzugte Startseite, die beim Öffnen des Browsers oder beim Klick auf den Home-Button (Alt+Pos1) geladen wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,10" />

                                <RadioButton x:Name="RadioHomeNexa"
                                             Content="Nexa Startseite (about:start – mit Uhrzeit und Suche)"
                                             GroupName="HomePageSelection"
                                             Checked="RadioHome_Checked"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,0,0,8" />

                                <RadioButton x:Name="RadioHomeGoogle"
                                             Content="Google (https://www.google.com)"
                                             GroupName="HomePageSelection"
                                             Checked="RadioHome_Checked"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,0,0,8" />

                                <RadioButton x:Name="RadioHomeCustom"
                                             Content="Benutzerdefiniert (Eigene Webadresse)"
                                             GroupName="HomePageSelection"
                                             Checked="RadioHome_Checked"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,0,0,8" />

                                <!-- Custom URL Input -->
                                <StackPanel x:Name="PanelCustomHomeUrl" Margin="22,4,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Eigene Webadresse eingeben:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtHomePage"
                                             Padding="10,7"
                                             Background="{StaticResource BgSurfaceBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource AccentLightBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 5: Datenschutz ════ -->
                    <StackPanel x:Name="PanelDatenschutz" Visibility="Collapsed">
                        <TextBlock Text="Datenschutz &amp; Sicherheit" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Verwalte Cookies, temporäre Dateien, Verlauf und automatische Datenbereinigung." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Browserdaten jetzt bereinigen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Lösche selektiv gespeicherte Daten von deinem Computer." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,12" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Cookies löschen" Click="BtnClearCookies_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                    <Button Content="Cache leeren" Click="BtnClearCache_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                    <Button Content="Gesamten Verlauf leeren" Click="BtnClearHistory_Click" Padding="12,6" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource StatusWarningBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Integrierter Werbe- &amp; Tracker-Schutz (Privacy Shield)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Blockiert aggressive Werbebanner, Analytik- und Telemetrie-Skripte automatisch für schnellere Ladezeiten und höheren Datenschutz." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkEnableAdBlocker"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Browserdaten beim Beenden löschen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Löscht Cache, Cookies und Verlauf automatisch bei jedem Schließen des Browserfensters." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkClearDataOnExit"
                                          IsChecked="False"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel>
                                    <TextBlock Text="InPrivate-Modus (Inkognito)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Für maximale Privatsphäre kannst du ein InPrivate-Fenster (Strg+Umschalt+N) öffnen. In diesem Modus werden Verläufe, Cookies und Webdaten in einem isolierten Speicher abgelegt, der beim Schließen rückstandsfrei gelöscht wird." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 6: Downloads ════ -->
                    <StackPanel x:Name="PanelDownloads" Visibility="Collapsed">
                        <TextBlock Text="Downloads" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Konfiguriere den Speicherort und das Verhalten für heruntergeladene Dateien." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Download-Speicherort" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="In diesen Ordner werden heruntergeladene Dateien standardmäßig gespeichert." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Durchsuchen..."
                                            Click="BtnBrowseDownloadFolder_Click"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Background="{StaticResource BgHoverBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand" />
                                    <TextBox x:Name="TxtDownloadFolder"
                                             Padding="10,7"
                                             Background="{StaticResource BgSurfaceBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource AccentLightBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Vor jedem Download nach Speicherort fragen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Zeigt vor jedem Download einen Dateidialog zur Auswahl des Zielordners und Dateinamens an." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkAskDownloadLocation"
                                          IsChecked="False"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 7: Website-Berechtigungen ════ -->
                    <StackPanel x:Name="PanelBerechtigungen" Visibility="Collapsed">
                        <TextBlock Text="Website-Berechtigungen" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Verwalte den Zugriff von Websites auf Kamera, Mikrofon, Standort und Pop-ups." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Standardberechtigungen für neue Websites" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <!-- Camera -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Kamera" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ComboPermCamera" Width="130" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                        <ComboBoxItem Content="Erlauben" />
                                        <ComboBoxItem Content="Blockieren" />
                                    </ComboBox>
                                </DockPanel>

                                <!-- Microphone -->
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Mikrofon" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ComboPermMicrophone" Width="130" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                        <ComboBoxItem Content="Erlauben" />
                                        <ComboBoxItem Content="Blockieren" />
                                    </ComboBox>
                                </DockPanel>

                                <!-- Geolocation -->
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Standort" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ComboPermGeolocation" Width="130" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                        <ComboBoxItem Content="Erlauben" />
                                        <ComboBoxItem Content="Blockieren" />
                                    </ComboBox>
                                </DockPanel>

                                <!-- Notifications -->
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Benachrichtigungen" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ComboPermNotifications" Width="130" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Immer fragen" IsSelected="True" />
                                        <ComboBoxItem Content="Erlauben" />
                                        <ComboBoxItem Content="Blockieren" />
                                    </ComboBox>
                                </DockPanel>

                                <!-- Pop-ups -->
                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Pop-up-Fenster" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ComboPermPopups" Width="130" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Erlauben" IsSelected="True" />
                                        <ComboBoxItem Content="Blockieren" />
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Gespeicherte Website-Berechtigungen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Alle zurücksetzen" Click="BtnResetAllPermissions_Click" Padding="10,4" Background="{StaticResource BgHoverBrush}" Foreground="{StaticResource StatusErrorBrush}" BorderThickness="0" Cursor="Hand" />
                                </DockPanel>
                                <ListBox x:Name="ListSavedPermissions"
                                         MaxHeight="150"
                                         Background="{StaticResource BgSurfaceBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 8: Tastenkürzel ════ -->
                    <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                        <TextBlock Text="Tastenkürzel (Shortcuts)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Schnelle Navigation und Bedienung über Tastenkombinationen." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <!-- Tabs & Navigation -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tabs &amp; Fenster" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,3"><TextBlock Text="Neuer Tab" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + T" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Tab schließen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + W" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Geschlossenen Tab wiederherstellen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + T" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Nächster / Vorheriger Tab" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Tab / Strg + Umschalt + Tab" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Tab duplizieren" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + D" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Tab nach links / rechts verschieben" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + Umschalt + Bild↑ / Bild↓" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Tab stummschalten / laut schalten" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + M" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Neues Fenster / InPrivate-Fenster" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + N / Strg + Umschalt + N" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                            </StackPanel>
                        </Border>

                        <!-- Omnibox & Actions -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Webseite &amp; Aktionen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,3"><TextBlock Text="Adressleiste fokussieren" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + L" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Schnellsuche (Quick Search)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + K" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Neu laden / Stop" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="F5 / Strg + R" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Zurück / Vor / Startseite" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Alt + Links / Alt + Rechts / Alt + Pos1" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Lesezeichen hinzufügen / entfernen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + D" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Verlauf anzeigen" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + H" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Auf Seite suchen (Find)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + F" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Drucken / Seite speichern" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + P / Strg + S" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Zoom anpassen (Vergrößern / Verkleinern / 100%)" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Strg + [+] / [-] / [0]" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Vollbildmodus ein/aus" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="F11" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Browser-Task-Manager" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Umschalt + Esc" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource AccentLightBrush}" /></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 9: Über Nexa ════ -->
                    <StackPanel x:Name="PanelUeber" Visibility="Collapsed">
                        <TextBlock Text="Über Nexa" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Systeminformationen, Versionen und Update-Prüfung." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border Width="48" Height="48" Background="{StaticResource AccentDimBrush}" CornerRadius="12" DockPanel.Dock="Left" Margin="0,0,14,0">
                                        <Image Source="pack://application:,,,/Assets/nexa_icon.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAboutBrowserName" Text="Nexa Browser" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Moderner, leichtgewichtiger Windows 11 Browser" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,10" />

                                <Grid Margin="0,4"><TextBlock Text="Browser-Version" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtAppVersion" Text="v1.0.0 (Release)" HorizontalAlignment="Right" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                                <Grid Margin="0,4"><TextBlock Text="WebView2 Runtime" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtWebViewVersion" Text="Wird ermittelt..." HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                                <Grid Margin="0,4"><TextBlock Text="Framework" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="TxtDotNetVersion" Text=".NET 10.0 (Windows x64)" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" /></Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Aktualisierungen" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtUpdateStatus" Text="Der Browser ist auf dem neuesten Stand." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Content="Updates prüfen"
                                        Click="BtnCheckUpdates_Click"
                                        Padding="14,6"
                                        Background="{StaticResource BgHoverBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <TextBlock Text="Entwicklertools (F12)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ermöglicht das Öffnen der Chromium-Entwicklertools zum Untersuchen von Webseiten." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkEnableDevTools"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 10: Passwörter & Autofill ════ -->
                    <StackPanel x:Name="PanelPasswoerter" Visibility="Collapsed">
                        <TextBlock Text="Passwörter &amp; Autofill" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Sicherer lokaler Tresor mit Windows DPAPI-Verschlüsselung und nahtlosem Google Passwörter / Chrome Import." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <!-- Card 0: Passwort-Sicherheits-Audit (Have I Been Pwned) -->
                        <Border Style="{StaticResource SettingCardStyle}" BorderBrush="#336366F1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#1A10B981" CornerRadius="8" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF10B981" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="🛡️ Passwort-Sicherheits-Audit (Have I Been Pwned)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtAuditSummary" Text="Gleiche deine Passwörter anonym gegen Milliarden bekannter Datenlecks ab (k-Anonymität)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnRunAudit" Content="Sicherheits-Check starten" Style="{StaticResource SettingsPrimaryBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRunAudit_Click" />
                                </DockPanel>

                                <ProgressBar x:Name="ProgressAudit" Height="4" Margin="0,4,0,6" Visibility="Collapsed" Maximum="100" />
                                <TextBlock x:Name="TxtAuditProgress" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Card 1: Google Passwörter Sync & Import -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border Background="#1A4285F4" CornerRadius="8" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF4285F4" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Google Passwörter &amp; Chrome Import" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Übertrage deine bestehenden Passwörter aus Google Chrome oder passwords.google.com mit einem Klick." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="💡" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="Öffne passwords.google.com im Browser, klicke oben rechts auf das Zahnrad ⚙️ und wähle 'Passwörter exportieren'. Die heruntergeladene CSV-Datei kannst du hier direkt einlesen." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>

                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnGoToSyncTab" Content="☁️ Google Cloud-Sync (Drive)" Style="{StaticResource SettingsPrimaryBtnStyle}" Margin="0,0,10,6" Click="BtnGoToSyncTab_Click" />
                                    <Button x:Name="BtnImportGoogleCsv" Content="📥 Google Passwörter CSV importieren" Style="{StaticResource SettingsActionBtnStyle}" Margin="0,0,10,6" Click="BtnImportGoogleCsv_Click" />
                                    <Button x:Name="BtnExportCsv" Content="📤 Tresor exportieren (.csv)" Style="{StaticResource SettingsActionBtnStyle}" Margin="0,0,10,6" Click="BtnExportCsv_Click" />
                                    <Button x:Name="BtnOpenGooglePasswords" Content="🌐 passwords.google.com öffnen" Style="{StaticResource SettingsActionBtnStyle}" Margin="0,0,0,6" Click="BtnOpenGooglePasswords_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Passwort-Generator -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border Background="#1A10B981" CornerRadius="8" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF10B981" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Starkes Passwort generieren" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Erzeuge kryptografisch sichere Passwörter mit anpassbarer Länge und Zeichensätzen." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtGeneratedPassword" IsReadOnly="True" FontFamily="Consolas, monospace" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,8" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="BtnCopyGeneratedPassword" Content="📋 Kopieren" Style="{StaticResource SettingsActionBtnStyle}" Margin="8,0,0,0" Click="BtnCopyGeneratedPassword_Click" />
                                    <Button Grid.Column="2" x:Name="BtnRegeneratePassword" Content="🔄 Neu würfeln" Style="{StaticResource SettingsActionBtnStyle}" Margin="6,0,0,0" Click="BtnRegeneratePassword_Click" />
                                </Grid>

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Länge:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtGenLengthVal" Text="18 Zeichen" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Width="75" VerticalAlignment="Center" />
                                    <Slider x:Name="SliderGenLength" Minimum="8" Maximum="48" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderGenLength_ValueChanged" />
                                </DockPanel>

                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkGenUpper" Content="Großbuchstaben (A-Z)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,6" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed" />
                                    <CheckBox x:Name="ChkGenLower" Content="Kleinbuchstaben (a-z)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,6" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed" />
                                    <CheckBox x:Name="ChkGenNumbers" Content="Ziffern (0-9)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,6" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed" />
                                    <CheckBox x:Name="ChkGenSymbols" Content="Sonderzeichen (!@#$...)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,6" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Passwort-Tresor Liste & Verwaltung -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Gespeicherte Zugangsdaten" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtVaultCount" Text="0 Passwörter im Tresor" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnToggleAddForm" Content="+ Neues Konto hinzufügen" Style="{StaticResource SettingsPrimaryBtnStyle}" HorizontalAlignment="Right" Click="BtnToggleAddForm_Click" />
                                </DockPanel>

                                <!-- Add Account Form (collapsible) -->
                                <Border x:Name="BorderAddAccountForm" Visibility="Collapsed" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Neues Passwort hinzufügen" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Webseite / Titel *" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtNewTitle" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="URL (z. B. https://example.com) *" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtNewUrl" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Benutzername / E-Mail *" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtNewUsername" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Passwort *" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtNewPassword" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Notiz (optional)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="TxtNewNote" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Abbrechen" Style="{StaticResource SettingsActionBtnStyle}" Margin="0,0,8,0" Click="BtnCancelAddForm_Click" />
                                            <Button Content="Speichern" Style="{StaticResource SettingsPrimaryBtnStyle}" Click="BtnSaveNewAccount_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Search Box -->
                                <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="TxtSearchVault" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center" TextChanged="TxtSearchVault_TextChanged" />
                                    </DockPanel>
                                </Border>

                                <!-- Empty State -->
                                <Border x:Name="BorderVaultEmpty" Visibility="Collapsed" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Stretch" Margin="0,4,0,4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔐" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Noch keine Passwörter gespeichert" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Importiere deine Google Passwörter CSV oder speichere Logins direkt beim Anmelden." Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Password Items Control -->
                                <ItemsControl x:Name="ListPasswordEntries">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🔑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <Border Visibility="{Binding BreachBadgeVisibility}" Background="#2AEE4444" BorderBrush="#80EE4444" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding BreachBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#FFF87171" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Host}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,1,0,0" />
                                                        </DockPanel>
                                                        
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                                                <TextBlock Text="Benutzer: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                                                <Button Tag="{Binding}" ToolTip="Benutzername kopieren" Style="{StaticResource VaultIconBtnStyle}" Width="22" Height="22" Margin="4,-2,0,-2" Click="BtnCopyUsername_Click">
                                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                            
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="Passwort: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding DisplayPassword}" FontFamily="Consolas, monospace" Foreground="{StaticResource AccentLightBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button Tag="{Binding}" ToolTip="Passwort ein-/ausblenden" Style="{StaticResource VaultIconBtnStyle}" Width="22" Height="22" Margin="4,-2,0,-2" Click="BtnToggleReveal_Click">
                                                                    <TextBlock Text="{Binding RevealIcon}" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                </Button>
                                                                <Button Tag="{Binding}" ToolTip="Passwort kopieren" Style="{StaticResource VaultIconBtnStyle}" Width="22" Height="22" Margin="2,-2,0,-2" Click="BtnCopyPassword_Click">
                                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="{Binding}" ToolTip="Eintrag löschen" Style="{StaticResource VaultIconBtnStyle}" Width="28" Height="28" Click="BtnDeletePassword_Click">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FFEF4444" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════ PANEL 11: Konto & Synchronisierung (Google Drive) ════ -->
                    <StackPanel x:Name="PanelSync" Visibility="Collapsed">
                        <TextBlock Text="Konto &amp; Synchronisierung" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Synchronisiere deine Passwörter, Lesezeichen und Einstellungen sicher und verschlüsselt über Google Drive." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,20" />

                        <!-- 1. Account Status Card (Connected or Disconnected) -->
                        <Border Style="{StaticResource SettingCardStyle}" Background="{StaticResource BgSurfaceBrush}">
                            <StackPanel>
                                <!-- DISCONNECTED STATE -->
                                <StackPanel x:Name="SyncDisconnectedPanel" Visibility="Visible">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                        <Border Width="46" Height="46" CornerRadius="12" Background="#183B82F6" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FF3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Nicht angemeldet" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Verbinde dein Google-Konto für automatischen Multi-Geräte-Sync" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Zero-Knowledge Security Badge Notice -->
                                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                        <DockPanel>
                                            <TextBlock Text="🛡️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ende-zu-Ende Zero-Knowledge Verschlüsselung: Deine Passwörter werden lokal mit AES-256-GCM verschlüsselt, bevor sie Google Drive erreichen. Selbst Google kann deine Daten nicht einsehen." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Action Button -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnGoogleLogin"
                                                Click="BtnGoogleLogin_Click"
                                                Content="🚀 Mit Google anmelden &amp; synchronisieren"
                                                Style="{StaticResource SettingsPrimaryBtnStyle}"
                                                Padding="20,10"
                                                FontSize="13"
                                                Margin="0,0,12,0" />
                                        
                                        <Button x:Name="BtnSyncViaFolder"
                                                Click="BtnSyncViaFolder_Click"
                                                Content="📁 Lokalen Google Drive Ordner wählen"
                                                Style="{StaticResource SettingsActionBtnStyle}"
                                                Padding="16,10"
                                                FontSize="12" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- CONNECTED STATE -->
                                <StackPanel x:Name="SyncConnectedPanel" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                        <Border x:Name="UserAvatarBorder" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentPrimaryBrush}" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtUserInitials" Text="G" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock x:Name="TxtUserName" Text="Google Nutzer" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Border Background="#2010B981" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Verbunden" FontSize="10" FontWeight="Bold" Foreground="#FF10B981" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtUserEmail" Text="user@gmail.com" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock x:Name="TxtLastSyncTime" Text="Zuletzt synchronisiert: Gerade eben" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="BtnSyncNow"
                                                Click="BtnSyncNow_Click"
                                                Content="🔄 Jetzt synchronisieren"
                                                Style="{StaticResource SettingsPrimaryBtnStyle}"
                                                Padding="18,8"
                                                Margin="0,0,10,0" />
                                        
                                        <Button x:Name="BtnLogoutGoogle"
                                                Click="BtnLogoutGoogle_Click"
                                                Content="Abmelden &amp; Trennen"
                                                Style="{StaticResource SettingsActionBtnStyle}"
                                                Padding="14,8"
                                                Foreground="#FFEF4444" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. What to Sync Checkboxes Card -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Zu synchronisierende Daten" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔑 Passwörter &amp; Anmeldedaten" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Gleichzeitige Synchronisation aller gespeicherten Passwörter" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSyncPasswords" IsChecked="True" Click="ChkSyncOption_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,6,0,10" />

                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔖 Lesezeichen &amp; Favoriten" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Alle Lesezeichen über alle Nexa-Instanzen synchron halten" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSyncBookmarks" IsChecked="True" Click="ChkSyncOption_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,6,0,10" />

                                <DockPanel Margin="0,0,0,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚙️ Einstellungen &amp; Themes" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Suchmaschinen-Präferenzen und Standard-Zoom synchronisieren" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSyncSettings" IsChecked="True" Click="ChkSyncOption_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Advanced / Custom Google Cloud Console Client ID -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <TextBlock Text="Erweiterte Google Cloud Konfiguration (Optional)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Möchtest du ein eigenes Google Cloud Projekt nutzen? Trage hier deine Client-ID ein." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                                <TextBlock Text="Google Client-ID" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCustomClientId"
                                         Height="30"
                                         Background="{StaticResource BgSurfaceBrush}"
                                         BorderBrush="{StaticResource BorderDefaultBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Padding="8,4"
                                         FontSize="12"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Lokaler Google Drive Ordner (Alternativer Datei-Sync)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Durchsuchen..." Click="BtnBrowseLocalDriveFolder_Click" Style="{StaticResource SettingsActionBtnStyle}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                                    <TextBox x:Name="TxtLocalDriveFolder"
                                             Height="30"
                                             Background="{StaticResource BgSurfaceBrush}"
                                             BorderBrush="{StaticResource BorderDefaultBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Padding="8,4"
                                             FontSize="12" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ═══ Footer Bar ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgDeepestBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,10">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtSaveStatus"
                           Text=""
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#FF10B981"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Verwerfen"
                            Click="BtnReset_Click"
                            Padding="16,7"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0" />
                    <Button Content="Einstellungen speichern"
                            Click="BtnSave_Click"
                            Padding="20,8"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
