<Window x:Class="Browser.Views.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexa Browser – Update"
        Height="440" Width="490"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">

    <Border BorderBrush="#272B4B"
            BorderThickness="1"
            CornerRadius="16"
            Background="#0C0E1A">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Direction="270" Opacity="0.7" ShadowDepth="12" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Header / Drag Area -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Click="BtnClose_Click"
                        Width="30" Height="30"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E11D48" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Nexa Browser Update"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               VerticalAlignment="Center" />
                    <TextBlock Text="• GitHub Releases"
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- State 1: Checking for updates -->
            <Grid x:Name="PanelChecking" Grid.Row="1" VerticalAlignment="Center" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16" Foreground="#6366F1" Background="#16182B" BorderThickness="0" />
                    <TextBlock Text="Prüfe GitHub auf Updates..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Verbinde mit github.com/venox21/Nexa-Browser..."
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- State 2: Up to date state -->
            <Grid x:Name="PanelUpToDate" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Emerald Checkmark Badge with glow -->
                    <Border Width="72" Height="72"
                            CornerRadius="36"
                            Background="#09291E"
                            BorderBrush="#10B981"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" Color="#10B981" Opacity="0.5" ShadowDepth="0" />
                        </Border.Effect>
                        <TextBlock Text="✓"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#34D399"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Du bist auf dem neuesten Stand"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"
                               HorizontalAlignment="Center" />

                    <!-- Version pill -->
                    <Border Background="#151732"
                            BorderBrush="#2F356B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,4"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,14">
                        <TextBlock x:Name="TxtCurrentVersionPill"
                                   Text="Version 2.0 (Aktuell)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#A5B4FC" />
                    </Border>

                    <TextBlock Text="Es sind keine neuen Updates verfügbar. Alle aktuellen Leistungs- und Sicherheitsfeatures sind aktiv und auf dem neuesten Stand."
                               FontSize="12"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="390"
                               Margin="0,0,0,10" />

                    <!-- Feature Pills -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Border Background="#121528" BorderBrush="#242848" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="⚡ Turbo-DNS" FontSize="11" Foreground="#CBD5E1" />
                        </Border>
                        <Border Background="#121528" BorderBrush="#242848" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="🚀 Instant-Cache" FontSize="11" Foreground="#CBD5E1" />
                        </Border>
                        <Border Background="#121528" BorderBrush="#242848" BorderThickness="1" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="🛡️ Shield Pro" FontSize="11" Foreground="#CBD5E1" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- State 3: Update Available state -->
            <Grid x:Name="PanelUpdateAvailable" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Indigo Rocket Badge with glow -->
                    <Border Width="68" Height="68"
                            CornerRadius="34"
                            Background="#181538"
                            BorderBrush="#6366F1"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" Color="#6366F1" Opacity="0.5" ShadowDepth="0" />
                        </Border.Effect>
                        <TextBlock Text="🚀"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Neues Update verfügbar!"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"
                               HorizontalAlignment="Center" />

                    <!-- Version upgrade arrow -->
                    <Border Background="#181B34"
                            BorderBrush="#4338CA"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,3"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,10">
                        <TextBlock x:Name="TxtUpgradePill"
                                   Text="v1.0  ➜  v2.0"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A5B4FC" />
                    </Border>

                    <TextBlock x:Name="TxtChangelogBrief"
                               Text="Ein neues Leistungs-Update steht auf GitHub bereit!"
                               FontSize="12"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="390"
                               Margin="0,0,0,8" />

                    <!-- Download Progress Bar (visible during download) -->
                    <StackPanel x:Name="PanelDownloadProgress" Visibility="Collapsed" Margin="0,4,0,0">
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Width="280" Foreground="#6366F1" Background="#1A1C30" BorderThickness="0" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtDownloadProgress" Text="Lade NexaSetup.exe von GitHub herunter... 0%" FontSize="11" Foreground="#A5B4FC" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom Buttons -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="TxtCheckedTimestamp"
                           Text="Geprüft: Heute"
                           FontSize="11"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSecondary"
                            Click="BtnSecondary_Click"
                            Content="Später"
                            Height="36"
                            Padding="14,0"
                            FontSize="12"
                            Foreground="#94A3B8"
                            Background="#181A2D"
                            BorderBrush="#292D4A"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,8,0"
                            Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="sb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="sb" Property="Background" Value="#252945" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Action Button -->
                    <Button x:Name="BtnAction"
                            Click="BtnAction_Click"
                            Content="Schließen"
                            Height="36"
                            Padding="18,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="#4F46E5"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bb" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bb" Property="Background" Value="#6366F1" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bb" Property="Background" Value="#4338CA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
