<Window x:Class="NexaInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexa Browser Setup"
        Height="600" Width="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/nexa.ico"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <!-- Modern Windows 11 Primary Button Style -->
        <Style x:Key="Win11PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Color="#4F46E5" Opacity="0.35" ShadowDepth="2" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#6366F1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="Win11SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2036" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2F3352" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#292D4A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1A1C30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Windows 11 Danger / Uninstall Button Style -->
        <Style x:Key="Win11DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#221217" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4B1821" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7F1D1D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Checkbox Style -->
        <Style x:Key="Win11CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <!-- Main Window Container -->
    <Border Background="#0C0D18"
            BorderBrush="#252843"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Direction="270" Opacity="0.65" ShadowDepth="12" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Nexa Browser Setup"
                               Foreground="#A5B4FC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="• Windows 11 Edition"
                               Foreground="#64748B"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnMinimize"
                            Click="BtnMinimize_Click"
                            Content="&#xE921;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="10"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="30"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="BtnClose"
                            Click="BtnClose_Click"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="30"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E11D48" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Wizard Body Container -->
            <Grid Grid.Row="1" Margin="32,8,32,24">

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- PANEL 1: WILLKOMMEN (WELCOME)                                -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelWelcome" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <!-- Hero Logo with radial glow -->
                        <Border Width="76" Height="76"
                                CornerRadius="22"
                                Background="#14172E"
                                BorderBrush="#4338CA"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#6366F1" Opacity="0.5" ShadowDepth="0" />
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                                   Width="50" Height="50"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Nexa Browser"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Moderner, blitzschneller &amp; KI-unterstützter Windows 11 Webbrowser"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,3,0,10" />

                        <!-- Version badge -->
                        <Border Background="#1C1B3A"
                                BorderBrush="#3B3878"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,4"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <TextBlock Text="v2.0 • 64-Bit Edition"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#A5B4FC" />
                        </Border>

                        <!-- Existing installation detected banner -->
                        <Border x:Name="BorderExistingInstall"
                                Background="#131735"
                                BorderBrush="#4F46E5"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="4,0,4,10"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShadowExistingInstall" BlurRadius="16" Color="#4F46E5" Opacity="0.3" ShadowDepth="0" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDetectedIcon" Text="🚀" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtDetectedHeader"
                                                   Text="Update auf Version 2.0 verfügbar"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" />
                                        <TextBlock x:Name="TxtDetectedVersion"
                                                   Text="v1.0 ➜ v2.0"
                                                   FontSize="11"
                                                   Foreground="#A5B4FC"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock x:Name="TxtDetectedPath"
                                               Text="C:\...\Nexa Browser"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature Highlights -->
                        <StackPanel Margin="4,0,4,0">
                            <!-- Feature 1 -->
                            <Border Background="#121526"
                                    BorderBrush="#202444"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,7"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="🛡️" FontSize="15" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Integrierter AdBlocker &amp; YouTube Shield" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Blockiert Werbung, Popups und Tracking nativ ohne Plug-ins." FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="#121526"
                                    BorderBrush="#202444"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,7"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="✨" FontSize="15" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nexa KI-Assistent &amp; Seitenanalyse" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Webseiten zusammenfassen, Fragen stellen &amp; lokale KI nutzen." FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="#121526"
                                    BorderBrush="#202444"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,7">
                                <DockPanel>
                                    <TextBlock Text="⚡" FontSize="15" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Turbo-DNS, Instant-Cache &amp; Spotlight" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                        <TextBlock Text="Paralleles DNS-Prewarming, BackForwardCache &amp; Instant-Ladezeiten." FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Buttons -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <!-- State A: Existing Installation Detected -->
                        <DockPanel x:Name="PanelActionsExisting" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnWelcomeUninstall"
                                        Click="BtnUninstall_Click"
                                        Content="🗑️ Deinstallieren"
                                        Style="{StaticResource Win11DangerButtonStyle}"
                                        Margin="0,0,8,0"
                                        ToolTip="Löscht die vorhandene Version von Nexa Browser vom Computer" />
                                <Button x:Name="BtnWelcomeReinstall"
                                        Click="BtnWelcomeLaunchOrReinstall_Click"
                                        Content="🚀 Browser starten"
                                        Style="{StaticResource Win11SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Visibility="Visible"
                                        ToolTip="Startet den installierten Nexa Browser" />
                                <Button x:Name="BtnGoCustomize"
                                        Click="BtnGoCustomize_Click"
                                        Content="⚙️ Anpassen"
                                        Style="{StaticResource Win11SecondaryButtonStyle}"
                                        ToolTip="Installationsoptionen und Pfad ändern" />
                            </StackPanel>
                            <Button x:Name="BtnWelcomeUpdate"
                                    Click="BtnWelcomeUpdate_Click"
                                    Content="🔄 Auf Version 2.0 aktualisieren"
                                    Style="{StaticResource Win11PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    MinWidth="180"
                                    ToolTip="Überschreibt die alte Version und aktualisiert auf Version 2.0" />
                        </DockPanel>

                        <!-- State B: Clean / New Installation -->
                        <DockPanel x:Name="PanelActionsNew" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnGoCustomizeNew"
                                        Click="BtnGoCustomize_Click"
                                        Content="⚙️ Anpassen"
                                        Style="{StaticResource Win11SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button x:Name="BtnWelcomeUninstallNew"
                                        Click="BtnUninstall_Click"
                                        Content="🗑️ Deinstallieren"
                                        Style="{StaticResource Win11DangerButtonStyle}"
                                        ToolTip="Vorhandene Version deinstallieren" />
                            </StackPanel>
                            <Button x:Name="BtnExpressInstall"
                                    Click="BtnExpressInstall_Click"
                                    Content="Jetzt installieren (v2.0)"
                                    Style="{StaticResource Win11PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    MinWidth="170" />
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- PANEL 2: ANPASSEN / OPTIONEN (CUSTOMIZE)                     -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelCustomize" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,4,0,14">
                        <TextBlock Text="Installation anpassen"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="Wähle das Installationsverzeichnis und Verknüpfungsoptionen."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <!-- Path Card -->
                        <Border Background="#121526"
                                BorderBrush="#202444"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Installationsverzeichnis"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F0"
                                           Margin="0,0,0,8" />

                                <DockPanel>
                                    <Button x:Name="BtnBrowsePath"
                                            Click="BtnBrowsePath_Click"
                                            Content="Durchsuchen..."
                                            Style="{StaticResource Win11SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="12,0"
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0" />

                                    <Border Background="#090A12"
                                            BorderBrush="#252948"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8">
                                        <TextBox x:Name="TxtInstallPath"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#A5B4FC"
                                                 FontSize="12"
                                                 FontFamily="Consolas, monospace"
                                                 VerticalAlignment="Center"
                                                 TextChanged="TxtInstallPath_TextChanged" />
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="💡 Benutzerinstallation (erfordert keine Administratorrechte)"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Background="#121526"
                                BorderBrush="#202444"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Optionen &amp; Systemverknüpfungen"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F0"
                                           Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkDesktopShortcut"
                                          Content="Desktop-Verknüpfung erstellen"
                                          IsChecked="True"
                                          Style="{StaticResource Win11CheckBoxStyle}" />

                                <CheckBox x:Name="ChkStartMenuShortcut"
                                          Content="Startmenü-Eintrag hinzufügen"
                                          IsChecked="True"
                                          Style="{StaticResource Win11CheckBoxStyle}" />

                                <CheckBox x:Name="ChkRegisterDefaultBrowser"
                                          Content="Als Standardbrowser für Web &amp; HTML registrieren"
                                          IsChecked="True"
                                          Style="{StaticResource Win11CheckBoxStyle}" />

                                <CheckBox x:Name="ChkLaunchAfterInstall"
                                          Content="Nexa Browser nach Abschluss sofort starten"
                                          IsChecked="True"
                                          Style="{StaticResource Win11CheckBoxStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Buttons -->
                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnBackToWelcome"
                                    Click="BtnBackToWelcome_Click"
                                    Content="&lt; Zurück"
                                    Style="{StaticResource Win11SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button x:Name="BtnCustomizeUninstall"
                                    Click="BtnUninstall_Click"
                                    Content="🗑️ Deinstallieren"
                                    Style="{StaticResource Win11DangerButtonStyle}"
                                    ToolTip="Vorhandene Version aus diesem Verzeichnis deinstallieren" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCustomizeUpdate"
                                    Click="BtnUpdate_Click"
                                    Content="🔄 Aktualisieren"
                                    Style="{StaticResource Win11PrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    MinWidth="135"
                                    ToolTip="Überschreibt die vorhandenen Dateien mit der neuen Version" />
                            <Button x:Name="BtnStartInstall"
                                    Click="BtnStartInstall_Click"
                                    Content="Installation starten"
                                    Style="{StaticResource Win11SecondaryButtonStyle}"
                                    MinWidth="145" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- PANEL 3: INSTALLATION / UPDATE / UNINSTALL LÄUFT              -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelInstalling" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                        <!-- Pulsing Logo -->
                        <Border Width="72" Height="72"
                                CornerRadius="22"
                                Background="#14172E"
                                BorderBrush="#4338CA"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#6366F1" Opacity="0.5" ShadowDepth="0" />
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/nexa_icon.png"
                                   Width="46" Height="46"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="TxtInstallingTitle"
                                   Text="Nexa Browser wird eingerichtet"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />

                        <TextBlock x:Name="TxtStatus"
                                   Text="Vorgang wird vorbereitet..."
                                   FontSize="12"
                                   Foreground="#A5B4FC"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,20" />

                        <!-- Modern Fluent ProgressBar -->
                        <Border CornerRadius="5" Height="8" Background="#16182B" Margin="0,0,0,10" ClipToBounds="True">
                            <ProgressBar x:Name="InstallProgressBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="8"
                                         Background="Transparent"
                                         Foreground="#6366F1"
                                         BorderThickness="0" />
                        </Border>

                        <DockPanel Margin="2,0,2,0">
                            <TextBlock x:Name="TxtDetail"
                                       Text="Initialisiere Setup..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="340" />
                            <TextBlock x:Name="TxtPercent"
                                       Text="0%"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- PANEL 4: FERTIGGESTELLT (FINISH)                             -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelFinish" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                        <!-- Success / Finish Icon Badge -->
                        <Border x:Name="BorderFinishIcon"
                                Width="80" Height="80"
                                CornerRadius="40"
                                Background="#0D2E24"
                                BorderBrush="#10B981"
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" Color="#10B981" Opacity="0.5" ShadowDepth="0" />
                            </Border.Effect>
                            <TextBlock x:Name="TxtFinishIcon"
                                       Text="✓"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#34D399"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="TxtFinishTitle"
                                   Text="Installation erfolgreich!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />

                        <TextBlock x:Name="TxtFinishSubtitle"
                                   Text="Nexa Browser wurde erfolgreich auf deinem Windows 11 PC eingerichtet."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,24" />

                        <!-- Finish Card (Launch option, hidden on uninstall) -->
                        <Border x:Name="BorderFinishLaunchCard"
                                Background="#121526"
                                BorderBrush="#202444"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkLaunchFinish"
                                          Content="Nexa Browser jetzt starten"
                                          IsChecked="True"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#F8FAFC"
                                          Style="{StaticResource Win11CheckBoxStyle}" />
                                <TextBlock Text="Öffnet deinen Browser sofort nach Klick auf Fertigstellen."
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="24,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Button -->
                    <Button x:Name="BtnFinish"
                            Grid.Row="1"
                            Click="BtnFinish_Click"
                            Content="Fertigstellen"
                            Style="{StaticResource Win11PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="160" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
